# OpenAI 兼容 API 配置 —— 任意厂商都能接，代码不绑定供应商
# 复制本文件为 .env 并填入你自己的值；网页端也能直接选预设、改地址和模型
#
# 常用端点（地址 + 模型名按你账号实际可用的填，型号会随厂商更新）
#   OpenAI / GPT          https://api.openai.com/v1                                   gpt-4o-mini
#   DeepSeek 官方          https://api.deepseek.com/v1                                 deepseek-chat
#   Kimi / Moonshot        https://api.moonshot.cn/v1                                  moonshot-v1-8k
#   Google Gemini 兼容层   https://generativelanguage.googleapis.com/v1beta/openai/   gemini-2.5-flash
#   通义千问               https://dashscope.aliyuncs.com/compatible-mode/v1          qwen-plus
#   智谱 GLM               https://open.bigmodel.cn/api/paas/v4                        glm-4-flash
#   硅基流动               https://api.siliconflow.cn/v1                               Qwen/Qwen2.5-7B-Instruct
#   本地 Ollama            http://127.0.0.1:11434/v1                                  qwen2.5
#   任意中转 / 自建        填对方给的 /v1 地址即可

# API Key（可选；仅 plan/iterate 规划或 LLM 论文润色需要）
OPENAI_API_KEY=在此填入你的API_Key

# API 地址（默认学校网关；换成上表任意一行即可）
OPENAI_BASE_URL=https://apiai.sztu.edu.cn/v1

# 模型名
OPENAI_MODEL=deepseek-v4-pro

# 额外请求体：只有学校网关这类 vLLM 系才需要下面这行；
# 换到 GPT / Kimi / Gemini / 通义等，改成 LLM_EXTRA_BODY={}（网页选预设会自动填好）。
LLM_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}

# 参数命名风格：auto 会自动识别 o1/o3/gpt-5 等推理模型；
# 端点仍报参数错误时兼容层会自动降级重试，一般不用手动改。
# LLM_PARAM_STYLE=auto

# ── 备用通道（强烈建议配一条） ──────────────────────────────────────────
# 校园网关排队 / 502 / queue.full 时，连续失败 LLM_FAILOVER_AFTER 次就自动切到这条，
# 不用等人来救，也不会因为换通道而降级产出。任何 OpenAI 兼容端点都能填，代码不用改。
# 注意：多数商用端点不认上面那个 chat_template_kwargs，备用通道的 extra body 留空即可。
# OPENAI_BASE_URL_2=https://api.deepseek.com/v1
# OPENAI_API_KEY_2=在此填入备用API_Key
# OPENAI_MODEL_2=deepseek-chat
# LLM_EXTRA_BODY_2={}

# 换到不限流的端点后把节流调小（默认 1.2s 是为校园网关排队设计的），
# 一次完整运行的耗时能明显下降；仍被限流就调回 1.5~2.5。
# LLM_MIN_INTERVAL=0.3
# LLM_FAILOVER_AFTER=3

# ── 文献源（跟模型网关是两套服务，换 LLM API 不会修好文献源限流） ──────
# 填真实邮箱可进 Crossref / OpenAlex 的 polite pool，限流阈值明显放宽。
# LIT_CONTACT_EMAIL=你的邮箱@example.com
# 默认六源全开、单源 429 自动降权；只想要稳的两条就写下面这样。
# LIT_SOURCES=crossref,arxiv,local
# local 源读 corpus/imports/ 下的 .bib/.json/.csv/.ris：把知网、Google Scholar
# 导出的题录放进去即可，不联网、永不限流，也是中文文献与导师指定必引文献的入口。
